# Contact form: requests are sent through your Gmail account.
# Copy to .env.local for local testing, and add the same values in
# Vercel → Project → Settings → Environment Variables.
#
# The Gmail address that sends the emails
GMAIL_USER=
# A Google "app password" (16 letters), NOT your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification).
GMAIL_APP_PASSWORD=
# Optional. Where requests are delivered; defaults to GMAIL_USER.
# Comma-separate several addresses.
CONTACT_TO_EMAIL=
